# Debate demo - OpenAI compatible LLM settings
# For a company-hosted model, set all three values below.
DEBATE_BASE_URL=https://your-llm-gateway.example.com/v1
DEBATE_MODEL_NAME=your-model-name
DEBATE_API_TOKEN=your_api_token_here

# Backward-compatible OpenAI settings are also supported:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_API_KEY=your_openai_api_key_here

# Google API Key - required for both LangGraph (Gemini) and ADK agents
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
